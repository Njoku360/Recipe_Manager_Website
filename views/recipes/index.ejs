<% layout('layouts/boilerplate') %>

<!-- Header -->
<div class="flex items-center justify-betwen mb-6">
    <h1 class="text-3x1 font-bold">All Recipes</h1>
    <a href="/recipes/new"
        class="bg-brand-600 hover:bg-brand-700 text-white px-4 py-2 rounded-lg font-medium">
        Add Recipe
    </a>
</div>

<!-- Search Area -->
<form method="GET" action="/recipes" class="mb-6">
    <div class="flex gap-2">
        <input
            type="text"
            name="q"
            value="<%= q || '' %>"
            placeholder="Search Recipes or Ingredients..."
            class="flex-1 px-4 py-2 rounded-lg border border-slate-300 dark:border-slate-600
                bg-white dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500"
        />
        <button class="bg-slate-800 dark:bg-slate-700 text-white px-5 py-2 rounded-lg hover:opacity-90">
            Search
        </button>
        <% if (q || tag) { %>
            <!-- Used for reseting tag and search area to empty -->
            <a href="/recipes" class="px-4 py-2 rounded-lg border border-slate-300 dark:border-slate-600 hover:bg-slate-100 dark:hover:bg-slate-700">
                Clear
            </a>
        <% } %>
    </div>
</form>

<!-- Use Tag filters-->
<% if(allTags && allTags.length) { %>
    <div class="flex flex-wrap gap-2 mb-6">
        <a href="/recipes"
            class="px-3 py-1 rounded-full text-sm border
                <%= !tag ? 'bg-brand-600 text-white border-brand-600' : 'border-slate-300 dark:border-slate-600 hover:bg-slate-700' %> ">
            All
        </a>
        <% allTags.forEach(t => { %>
            <a href="/recipes?tag=<%= t %>"
                class="px-3 py-1 rounded=full text-sm border
                    <%= tag === t? 'bg-brand-600 text-white border-brand-600' : 'border-slate-300 dark:border-slate-600 hover:bg-slate-100 dark:hover:bg-slate-700' %>">
                <%= t %>
            </a>
        <% }) %>
    </div>
<% } %>

<!-- Recipe grid -->

<!-- If there's no recipe, add a recipe -->
<% if (recipes.length === 0){ %>
    <div class="text-center py-20 text-slate-500">
        <p class="text-lg">No recipes yet</p>
        <a href="/recipes/new" class="inline-block mt-4 text-brand-600 hover:underline">
            Add your first recipe
        </a>
    </div>
<% } else { %> 
    <!-- If there's already recipe, add the recipecard-->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:gird-cols-3 gap-6">
        <% recipes.forEach(recipe => { %>
            <%- include('../partials/recipeCard', {recipe}) %>
        <% }) %>
    </div>
<% } %>

