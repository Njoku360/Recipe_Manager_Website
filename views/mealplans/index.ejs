<!-- The Meal Plans Page -->

<!-- importing the boilerplate layout -->
<% layout('layouts/boilerplate') %>

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-3x1 font-bold">Meal Plan</h1>
        <!-- The current date of the meal plan -->
        <p class="text-slate-500 text-sm mt-1">
            Week of <%= new Date(plan.week).toDateString() %>
        </p>
    </div>
    <a href="/shopping"
       class="bg-brand-600 hover:bg-brand-700 text-white px-4 py-2 rounded-lg font-medium">
       Shopping List 
    </a>
</div>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">

    <!-- Recipe Sidebar (draggable) -->
    <aside class="lg:col-span-1">
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm sticky top-6">
            <h2 class="font-semibold mb-3">Your Recipes</h2>
            
            <!-- Search Input for Recipes -->
            <input
                type="text"
                placeholder="Search recipes..."
                class="w-full px-3 py-2 mb-3 rounded-lg border border-slate-300 dark:border-slate-600
                       bg-white dark:bg-slate-900 text-sm"
            />

            <div class="space-y-2 max-h-[60vh] overflow-y-auto">
                <!-- Drag each recipe into the meal plan -->
                <% recipes.forEach(recipe => { %>
                    <div
                        draggable="true"
                        data-recipe-id="<%= recipe._id %>"
                        class="recipe-chip cursor-grab active:cursor-grabbing
                               flex items-center gap-2 p-2 rounded-lg
                               bg-slate-100 dark:bg-slate-700 hover:bg-brand-50 dark:hover:bg-slate-600
                               transition text-sm"
                    >
                        <img src="<%=recipe.imageUrl %>" alt=""
                            class="w-10 h-10 rounded-md object-cover" />
                        <span class="truncate"><%= recipe.title %></span>
                    </div>
                <% }) %>

                <!-- If thers's no recipe, give a text to add some first -->
                <% if (recipes.length === 0) { %>
                    <p class="text-sm text-slate-500">No Recipes yet. Add some to get started!</p>
                <% } %>
            </div>
        </div>
    </aside>

    <!-- Weekly Grid for Meal Plan -->
    <section class="lg:col-span-3">
        <p class="mb-3 text-sm text-slate-600 dark:text-slate-300">
            Drag a recipe from Your Recipes and drop it on the day you want to use it. You can also drag more than one recipe on the same day.
        </p>
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-4">
            <!-- Render each day of the week -->
            <% days.forEach(day => { %>
                <div class="bg-white dark:bg-slate-800 rounded-2x1 p-3 shadow-sm min-h-[180px] flex flex-col">
                    <h3 class="font-semibold mb-2"><%= day %></h3>

                    <div
                        class="dropzone space-y-2 min-h-[120px] flex-1 rounded-lg p-1
                               border-2 border-dashed border-slate-200 dark:border-slate-700"
                        data-day="<%= day %>"
                    >   
                        <!-- Render meals for the day -->
                        <% const dayMeals = plan.days.filter(d => d.day === day); %>
                        <% dayMeals.forEach(meal => { %>
                            <div class="meal-item bg-brand-50 dark:bg-slate-700 rounded-lg p-2 text-xs relative group">
                                <% if (meal.recipe) { %>
                                    <% if (meal.recipe.imageUrl) { %>
                                        <img src="<%= meal.recipe.imageUrl %>" alt=""
                                            class="w-full h-14 object-cover rounded-md mb-1" />
                                    <% } %>
                                    <div class="flex items-center justify-between gap-2">
                                        <a href="/recipes/<%= meal.recipe._id %>"
                                            class="min-w-0 truncate hover:underline font-medium">
                                            <%= meal.recipe.title %>
                                        </a>
                                        <form action="/mealplans/remove" method="POST" class="shrink-0">
                                        <input type="hidden" name="day" value="<%= day %>"/>
                                        <input type="hidden" name="recipeId" value="<%= meal.recipe._id %>"/>
                                            <button type="submit"
                                                aria-label="Delete <%= meal.recipe.title %> from meal plan"
                                                title="Delete from meal plan"
                                                class="inline-flex h-8 w-8 items-center justify-center rounded border border-red-300 text-red-700 hover:bg-red-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700 dark:border-red-500 dark:text-red-300 dark:hover:bg-slate-600">
                                                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                                                    class="h-4 w-4">
                                                    <path d="M3 6h18" />
                                                    <path d="M8 6V4h8v2" />
                                                    <path d="m19 6-1 14H6L5 6" />
                                                    <path d="M10 11v6M14 11v6" />
                                                </svg>
                                        </button>
                                        </form>
                                    </div>
                                <% } else { %>
                                    <p class="text-slate-500">This recipe is no longer available.</p>
                                <% } %>
                            </div>
                        <% }) %>
                    </div>
                </div>
            <% }) %>  
        </div>
    </section>
</div>

<!-- Hidden form used by drag and drop-->
<form id="add-meal-form" action="/mealplans/add" method="POST" class="hidden">
    <input type="hidden" name="day" id="hidden-day"/>
    <input type="hidden" name="recipeId" id="hidden-recipe"/>
</form>

<script src="/js/planner.js" defer></script>