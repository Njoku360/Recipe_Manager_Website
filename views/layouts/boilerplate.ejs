<!Doctype html>
<html lang="en" class="">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title><%= locals.title || 'Recipe Manager' %></title>

        <link rel="stylesheet" href="/css/tailwind.css" />
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 view=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>BoilerPlate</text></svg>" />
    </head>
    <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 dark:bg-slate-900 dark:text-slate-100">

        <%- include('../partials/navbar') %>
        <%- include('../partials/flash') %>

        <main class="flex-1 max-w-6xl w-full mx-auto px-4 py-8">
            <%- body %>
        </main>

        <%- include('../partials/footer') %>

        <script>
            // Dark mode 
            const html = document.documentElement
            const themeToggle = document.getElementById('theme-toggle')

            const updateThemeToggle = () => {
                const isDark = html.classList.contains('dark')
                themeToggle.textContent = isDark ? '☀️' : '🌙'
                themeToggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode')
            }

            // Save the theme that was toggled on last and get it when the page is rendered later on the browser
            const saved = localStorage.getItem('theme')
            if(saved === 'dark') html.classList.add('dark')
            updateThemeToggle()

            // Activated the theme-toggle on button to create the dark or light mode
            document.addEventListener('click', e => {
                if(e.target.closest('#theme-toggle')){
                    html.classList.toggle('dark')
                    updateThemeToggle()

                    // If the button is toggled on as dark? the page should be in dark mode, else it should be in light mode  
                    localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light')
                }
            })
        </script>
    </body>
</html>