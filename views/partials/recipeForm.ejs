<!-- Recipe Form -->
<form action="<%= action %>" method="POST" enctype="multipart/form-data" class="space-y-6">
    <% if (method) { %>
        <input type="hidden" name="_method" value="<%= method %>" />
    <% } %>

    <!-- Title + Description -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 shadow-sm space-y-4">
        <div>
            <label class="block text-sm font-medium mb-1">Title *</label>
            <input
                type="text" name="recipe[title]" required
                value="<%= recipe.title || '' %>"
                class="w-full px-4 py-2 rounded-lg border border-slate-300 dark:border-slate-600
                    bg-white dark:bg-slate-900 focus:ring-2 focus:ring-brand-500 outline-none"
            />
        </div>
        <div>
           <label class="block text-sm font-medium mb-1">Description</label> 
           <textarea
                name="recipe[description]"
                rows="3"
                class="w-full px-4 py-2 rounded-lg border border-slate-300 dark:border-slate-600
                    bg-white dark:bg-slate-900 focus:ring-2 focus:ring-brand-500 outline-none"
            ><%= recipe.description || '' %></textarea>
        </div>
    </div>
    <!-- Data needed for the form -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 shadow-sm">
        <div class="grid grid-cols-2 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium mb-1">Prep Time (minutes)</label>
                <input type="number" name="recipe[prepTime]" min="0"
                    value="<%= recipe.prepTime || 0 %>"
                    class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-600
                        bg-white dark:bg-slate-900
                    "
                />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Cook Time (minutes)</label>
                <input type="number" name="recipe[cookTime]" min="0"
                    value="<%= recipe.cookTime || 0 %>"
                    class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-600
                        bg-white dark:bg-slate-900
                    "
                />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Servings</label>
                <input type="number" name="recipe[servings]" min="1"
                    value="<%= recipe.servings || 4 %>"
                    class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-600
                        bg-white dark:bg-slate-900
                    "
                />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Tags (comma separated)</label>
                <input type="text" name="recipe[tags]"
                    value="<%= (recipe.tags || []).join(', ') %>"
                    placeholder="e.g. vegetarian, noodles, pasta"
                    class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-600
                        bg-white dark:bg-slate-900
                    "
                />
            </div>
        </div>
    </div>

    <!-- Image Upload -->
    <div class="bg-white dark:bg-slate-800 rounded-2x1 p-6 shadow-sm">
        <label class="block text-sm font-medium mb-1">Image</label>
        <input type="file" name="image" accept="image/*"
            class="block w-full text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-brand-600 
                   file:text-white hover:file:bg-brand-700
            "
        />
        <% if (recipe.imageUrl) { %>
            <img src="<%= recipe.imageUrl %>" alt="<%= recipe.title %>" class="mt-3 w-40 rounded-lg border border-slate-200 dark:border-slate-700" />
        <% } %>
    </div>

    <!-- Ingredients -->
    <div class="bg-white dark:bg-slate-800 rounded-2x1 p-6 shadow-sm">
        <div class="flex items-center justify-between mb-3">
            <h2 class="font-semibold">Ingredients</h2>
            <button type="button" id="add-ingredient"
                class="text-sm text-brand-600 hover:underline">
                Add Ingredient
            </button>
        </div>
        <div id="ingredients-list" class="space-y-2">
            <% const ingreds = recipe.ingredients && recipe.ingredients.length ? recipe.ingredients: [{ name:'', quantity:'', unit:'g' }] %>
            <% ingreds.forEach((ing, index) => { %>
                <div class="flex gap-2 ingredient-row" data-index="<%= index %>">
                    <input type="text" name="ingredients[<%= index %>][name]" placeholder="Ingredient Name"
                        value="<%= ing.name %>"
                        class="flex-1 px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-600
                            bg-white dark:bg-slate-900
                        "
                    />
                    <input type="number" name="ingredients[<%= index %>][quantity]" min="0" step="any"
                        value="<%= ing.quantity %>"
                        placeholder="Quantity"
                        class="w-24 px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-600
                            bg-white dark:bg-slate-900
                        "
                    />
                    <select name="ingredients[<%= index %>][unit]"
                        class="w-24 px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-600
                            bg-white dark:bg-slate-900
                        "
                    >
                        <% ['g', 'kg', 'ml', 'l', 'tsp', 'tbsp', 'cup', 'piece'].forEach(unit => { %>
                            <option value="<%= unit %>" <%= ing.unit === unit ? 'selected' : '' %>><%= unit %></option>
                        <% }) %>
                    </select>
                    <button type="button" class="remove-row px-3 text-red-500 hover:text-red-700">Remove</button>
                </div>
            <% }) %>
        </div>
    </div>

    <!-- Steps -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 shadow-sm">
        <div class="flex items-center justify-between mb-3">
            <h2 class="font-semibold">Steps</h2>
            <button type="button" id="add-step" class="text-sm text-brand-600 hover:underline">
                Add Step
            </button>
        </div>
        <div id="steps-list" class="space-y-3">
            <% const steps = recipe.steps && recipe.steps.length ? recipe.steps : [{ text: '' }] %>
            <% steps.forEach((step, index) => { %>
                <div class="step-row flex gap-2 items-start" data-index="<%= index %>">
                    <div class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-100 text-brand-700 font-semibold step-number">
                        <%= index + 1 %>
                    </div>
                    <textarea name="steps[<%= index %>][text]" rows="2" placeholder="Describe this step"
                        class="flex-1 px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900"
                    ><%= step.text || '' %></textarea>
                    <button type="button" class="remove-step px-3 text-red-500 hover:text-red-700">Remove</button>
                </div>
            <% }) %>
        </div>
    </div>

    <div class="flex gap-3">
        <button type="submit"
            class="bg-brand-600 hover:bg-brand-700 text-white px-6 py-2.5 rounded-lg font-medium">
            <%= submitLabel %>
        </button>
        <a href="/recipes" class="px-6 py-2.5 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-600 rounded-lg font-medium">
            Cancel
        </a>
    </div>
</form>

<!-- Include the script for dynamic ingredient rows -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const ingredientsList = document.getElementById('ingredients-list')
        const addIngredientButton = document.getElementById('add-ingredient')

        function reindexIngredients() {
            Array.from(ingredientsList.querySelectorAll('.ingredient-row')).forEach((row, index) => {
                row.dataset.index = index
                row.querySelectorAll('input, select').forEach((field) => {
                    const fieldName = field.name.replace(/ingredients\[\d+\]/, `ingredients[${index}]`)
                    field.name = fieldName
                })
            })
        }

        if (addIngredientButton && ingredientsList) {
            addIngredientButton.addEventListener('click', () => {
                const template = ingredientsList.querySelector('.ingredient-row')
                if (!template) return

                const row = template.cloneNode(true)
                const nextIndex = ingredientsList.querySelectorAll('.ingredient-row').length
                row.dataset.index = nextIndex
                row.querySelectorAll('input, select').forEach((field) => {
                    const base = field.name.includes('[name]') ? 'name' : field.name.includes('[quantity]') ? 'quantity' : 'unit'
                    field.name = `ingredients[${nextIndex}][${base}]`
                    if (field.tagName === 'SELECT') {
                        field.selectedIndex = 0
                    } else {
                        field.value = ''
                    }
                })
                ingredientsList.appendChild(row)
            })
        }

        const stepsList = document.getElementById('steps-list')
        const addStepButton = document.getElementById('add-step')

        function reindexSteps() {
            Array.from(stepsList.querySelectorAll('.step-row')).forEach((row, index) => {
                row.dataset.index = index
                const textArea = row.querySelector('textarea')
                const badge = row.querySelector('.step-number')
                if (textArea) textArea.name = `steps[${index}][text]`
                if (badge) badge.textContent = index + 1
            })
        }

        if (addStepButton && stepsList) {
            addStepButton.addEventListener('click', () => {
                const template = stepsList.querySelector('.step-row')
                if (!template) return

                const row = template.cloneNode(true)
                const nextIndex = stepsList.querySelectorAll('.step-row').length
                row.dataset.index = nextIndex
                const textArea = row.querySelector('textarea')
                if (textArea) {
                    textArea.value = ''
                    textArea.name = `steps[${nextIndex}][text]`
                }
                const badge = row.querySelector('.step-number')
                if (badge) {
                    badge.textContent = nextIndex + 1
                }
                stepsList.appendChild(row)
            })
        }

        document.addEventListener('click', (e) => {
            const removeIngredientBtn = e.target.closest('.remove-row')
            if (removeIngredientBtn) {
                const row = removeIngredientBtn.closest('.ingredient-row')
                if (!row) return

                const list = row.parentElement
                const rows = list.querySelectorAll('.ingredient-row')

                if (rows.length > 1) {
                    row.remove()
                    reindexIngredients()
                } else {
                    alert('At least one ingredient row is required.')
                }
                return
            }

            const removeStepBtn = e.target.closest('.remove-step')
            if (removeStepBtn) {
                const row = removeStepBtn.closest('.step-row')
                if (!row) return

                const list = row.parentElement
                const rows = list.querySelectorAll('.step-row')

                if (rows.length > 1) {
                    row.remove()
                    reindexSteps()
                } else {
                    alert('At least one step is required.')
                }
            }
        })
    })
</script>
