<% layout('layouts/boilerplate') %>

<div class="flex flex-col items-center justify-center py-20 text-center">
    <p class="text-7xl mb-4"><%= status === 404 ? '🔍' : '⚠️' %></p>

    <h1 class="text-3xl font-bold mb-2"><%= status %></h1>
    <p class="text-lg text-slate-600 dark:text-slate-400 mb-6"><%= message %></p>

    <% if (status === 404){ %>
        <p class="text-sm text-slate-500 mb-6">The page you're looking doesn't exist</p>
    <% } %>

    <a href="/" class="text-brand-600 hover:underline">Back to Home</a>
</div>